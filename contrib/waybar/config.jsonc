// wattif's Waybar modules. Add the names to one of your bar's module lists,
// e.g. "modules-right": [ "custom/wattif", "custom/vote-up", "custom/vote-down", ... ].
// Run `wattif eta` as a service (`wattif units --install` does) and these
// only read what it publishes, so they start instantly and cost nothing.
{
  // Time left with ± half its 80% interval and the live draw (`1:17 ±0:15 14.2W`);
  // charging: the battery time banked so far and the time to the charge limit.
  // The tooltip has the intervals, how long a suspend would last, and what is
  // using the battery. Classes: discharging, charging, plugged, weak-charger
  // (plugged in but still discharging), low, critical, fill0-fill100 (remaining
  // energy), no-battery, unknown.
  "custom/wattif": {
    "exec": "wattif waybar battery",
    "return-type": "json",
    "restart-interval": 10,
    "on-click": "wattif panel",
    "on-click-right": "wattif panel experiments"
  },
  // 👍 something is especially good right now; 👎 worse than it should be
  // (automatic experiments restore your settings at once and rest 10 minutes).
  // Each vote refreshes them on SIGRTMIN+12 (config [waybar] signal).
  "custom/vote-up": {
    "exec": "wattif waybar up",
    "return-type": "json",
    "interval": 15,
    "signal": 12,
    "on-click": "wattif vote up",
    "on-click-right": "wattif panel experiments"
  },
  "custom/vote-down": {
    "exec": "wattif waybar down",
    "return-type": "json",
    "interval": 15,
    "signal": 12,
    "on-click": "wattif vote down",
    "on-click-right": "wattif panel experiments"
  }
}
